# ============================================================
# FlowZone Environment Configuration
# Copy this to .env and fill in your values
# ============================================================

# ----- Application -----
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-string-in-production
APP_HOST=0.0.0.0
APP_PORT=8000

# ----- Database (PostgreSQL) -----
# For local Docker Compose:
DATABASE_URL=postgresql+asyncpg://flowzone:flowzone_dev@db:5432/flowzone
# For Railway (will be auto-set by Railway's Postgres plugin):
# DATABASE_URL=postgresql+asyncpg://...

# ----- LLM API Keys -----
# Paid models (used strategically based on budget)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Free tier models
GOOGLE_AI_API_KEY=
GROQ_API_KEY=

# ----- Model Router Configuration -----
# Daily budget cap in USD — when reached, all models fall back to free tier
DAILY_BUDGET_CAP_USD=3.00
# Budget tier thresholds (percentage of daily cap)
BUDGET_TIER_GREEN=0.60
BUDGET_TIER_YELLOW=0.85

# ----- Voice Pipeline -----
# STT provider: "browser" (Web Speech API, no backend cost) | "groq_whisper" | "deepgram"
STT_PROVIDER=groq_whisper
# TTS provider: "edge_tts" (free) | "none" (text only)
TTS_PROVIDER=edge_tts

# ----- RAG Configuration -----
# ChromaDB persistence path (inside container)
CHROMA_PERSIST_DIR=/app/data/chromadb
# Embedding model (runs on CPU)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ----- Google Drive Integration -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ----- Session Configuration -----
# Max conversation history messages kept in full (rest are summarized)
SESSION_HISTORY_WINDOW=8
# Hours of inactivity before a new session starts
SESSION_TIMEOUT_HOURS=8
# Max concurrent users
MAX_CONCURRENT_USERS=5

# ----- Safe Harbor -----
# Default floor for users with trauma history
SAFE_HARBOR_TRAUMA_FLOOR=yellow

# ----- Rate Limiting -----
# Per-user rate limit (messages per minute)
USER_RATE_LIMIT_PER_MINUTE=10
