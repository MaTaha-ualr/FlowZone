# ============================================================
# FlowZone Environment Configuration
# ============================================================

# ---- Application ----
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-32-char-random-string
APP_DEMO_MODE=false
APP_FRONTEND_URL=http://localhost:3000

# ---- CORS ----
# Comma-separated list of allowed origins
# Use "*" only in development
CORS_ORIGINS=*
# Production example:
# CORS_ORIGINS=https://app.flowzone.org,https://admin.flowzone.org

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://flowzone:flowzone_dev@db:5432/flowzone

# ---- LLM API Keys (at least one required) ----
# Paid providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Free-tier providers
GOOGLE_AI_API_KEY=
GROQ_API_KEY=

# ---- Model Router Budget ----
DAILY_BUDGET_CAP_USD=3.00
BUDGET_TIER_GREEN=0.60
BUDGET_TIER_YELLOW=0.85

# ---- Voice ----
# STT: openai_whisper (best, paid) | groq_whisper (free fallback) | browser
# TTS: openai_tts (best, paid) | edge_tts (free fallback) | none
STT_PROVIDER=openai_whisper
TTS_PROVIDER=openai_tts
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_STT_MODEL=whisper-1

# ---- RAG ----
RAG_ENABLED=true
CHROMA_PERSIST_DIR=/app/data/chromadb
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- Google Drive ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/documents/google-drive/callback

# ---- Session ----
SESSION_HISTORY_WINDOW=8
SESSION_TIMEOUT_HOURS=8
MAX_CONCURRENT_USERS=5

# ---- Rate Limiting ----
USER_RATE_LIMIT_PER_MINUTE=10
